# Normalise to LF in the repo; check out native on Windows.
* text=auto

# Shell scripts must keep LF or they fail to execute. gradlew is generated by
# Android Studio and is a shell script even on Windows checkouts.
gradlew         text eol=lf
*.sh            text eol=lf

*.bat           text eol=crlf
gradlew.bat     text eol=crlf

# Never mangle binaries.
*.onnx          binary
*.so            binary
*.wav           binary
*.jar           binary
*.apk           binary

# Reference transcripts are UTF-8 Devanagari; keep them LF and diffable.
eval/refs/*.txt text eol=lf
